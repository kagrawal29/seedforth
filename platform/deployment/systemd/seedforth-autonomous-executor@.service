[Unit]
Description=SeedForth bounded autonomous executor for %i
After=seedforth-worker.service
Requires=seedforth-worker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/seedforth/control-current
LoadCredential=worker.token:/opt/seedforth/shared/env/worker-%i.token
Environment=PYTHONPATH=/opt/seedforth/control-current/platform
Environment=SEEDFORTH_AUTONOMOUS_SCOPE=%i
Environment=SEEDFORTH_AUTONOMOUS_PRINCIPAL=principal-%i-upgrade-worker
Environment=SEEDFORTH_WORKER_SOCKET=/run/seedforth-worker/broker.sock
Environment=SEEDFORTH_WORKER_TOKEN_FILE=%d/worker.token
ExecStart=/usr/bin/python3 -m control.autonomous_executor
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=192M
TasksMax=32
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
