[Unit]
Description=Deliver graph-authenticated direction to Delta through a bounded adapter
After=docker.service seedforth-delta.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/seedforth/control-current
LoadCredential=neo4j.json:/opt/seedforth/shared/env/control-neo4j.json
Environment=CONTROL_GRAPH_CREDENTIALS=%d/neo4j.json
Environment=PYTHONPATH=/opt/seedforth/control-current/platform
Environment=SEEDFORTH_DELTA_HUB_INBOX=/opt/delta/hub/delta-config/inbox
Environment=SEEDFORTH_CONVERSATION_DELIVERY_ENABLED=1
ExecStart=/usr/bin/python3 -m control.delta_conversation_processor
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/opt/delta/hub/delta-config/inbox
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=128M
TasksMax=16
TimeoutStartSec=45
