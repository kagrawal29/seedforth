[Unit]
Description=Promote Delta conversation acknowledgements into Mycelium
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/seedforth/control-current
LoadCredential=neo4j.json:/opt/seedforth/shared/env/control-neo4j.json
Environment=CONTROL_GRAPH_CREDENTIALS=%d/neo4j.json
Environment=PYTHONPATH=/opt/seedforth/control-current/platform
Environment=SEEDFORTH_SHARED_DIR=/opt/seedforth/shared
ExecStart=/usr/bin/python3 -m control.ingest_delta_acks
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/opt/seedforth/shared
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=128M
TasksMax=16
TimeoutStartSec=45
