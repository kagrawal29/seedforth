[Unit]
Description=SeedForth Delta platform service
After=network.target docker.service supervisor.service
Requires=docker.service

[Service]
Type=simple
User=delta
Group=delta
WorkingDirectory=/opt/seedforth/current/platform/delta
EnvironmentFile=/opt/seedforth/shared/env/seedforth.env
ExecStart=/usr/bin/python3 -m delta.app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
