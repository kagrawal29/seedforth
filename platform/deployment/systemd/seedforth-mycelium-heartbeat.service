[Unit]
Description=SeedForth Mycelium heartbeat
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=delta
Group=delta
WorkingDirectory=/opt/seedforth/current/platform/delta
EnvironmentFile=/opt/seedforth/shared/env/seedforth.env
ExecStart=/usr/bin/python3 /opt/seedforth/current/platform/delta/tools/graph-runner.py --cadence heartbeat
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
