[Unit]
Description=Renew SeedForth public IP certificate and reload validated nginx
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
UMask=0077
ExecStart=/opt/seedforth/shared/certbot-venv/bin/certbot renew --non-interactive --no-random-sleep-on-renew --config-dir /opt/seedforth/shared/acme-production/config --work-dir /opt/seedforth/shared/acme-production/work --logs-dir /opt/seedforth/shared/acme-production/logs --webroot --webroot-path /var/lib/seedforth-acme
# Certbot may exit zero despite a failed deploy hook. Let systemd track both
# validation and reload as mandatory steps, including checks when not yet due.
ExecStartPost=/usr/sbin/nginx -t
ExecStartPost=/usr/bin/systemctl reload nginx.service
TimeoutStartSec=300
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/seedforth/shared/acme-production /var/lib/seedforth-acme /var/log/nginx /run/nginx.pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=256M
TasksMax=32
