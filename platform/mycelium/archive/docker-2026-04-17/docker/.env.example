# Maverick Meta Intelligence System — Required Environment Variables
# Copy this file to .env and fill in the values.
# Usage: docker run --env-file docker/.env maverick-meta

# Claude Code OAuth token (long-lived, from `claude setup-token`)
# Agent SDK spawns claude CLI which uses this for auth.
# Generate via: claude setup-token (on a machine with browser access)
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# LangSmith API key for trace ingestion
CC_LANGSMITH_API_KEY=lsv2_...

# GitHub personal access token (needs repo read/write for Qubit-Capital org)
GH_TOKEN=ghp_...

# Asgard Graph MCP server auth token
ASGARD_GRAPH_TOKEN=...

# Mode: "production" (full pipeline with distribution) or "test" (sandboxed, no pushes)
MODE=test
