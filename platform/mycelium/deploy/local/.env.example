# Maverick Local Docker Compose Configuration
# Copy this file to .env and adjust as needed.

# Neo4j password for the local graph (default: localtest12)
# Choose a secure password for your local development environment
MAVERICK_LOCAL_PASSWORD=localtest12

# Ollama model for embeddings (do not change unless you have a different model available)
# The bootstrap process will pull nomic-embed-text automatically
OLLAMA_MODEL=nomic-embed-text

# Embed-proxy service endpoint (for internal use, bind to localhost)
EMBED_PROXY_ADDR=0.0.0.0:7701
OLLAMA_URL=http://ollama:11434
