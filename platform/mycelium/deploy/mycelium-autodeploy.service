[Unit]
Description=Mycelium auto-deploy — pull latest main and bootstrap protocols
After=network-online.target neo4j.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/mycelium
# --ff-only so divergent history never silently merges; failure logs and exits.
ExecStart=/usr/bin/git pull --ff-only
# Bootstrap re-MERGEs Protocol nodes from graph/protocols/*.cypher; idempotent.
ExecStart=/usr/local/bin/mycelium-prod bootstrap
# If dev instance is up, keep it in lock-step so teammates see the same graph.
ExecStart=-/usr/local/bin/mycelium-dev bootstrap
StandardOutput=journal
StandardError=journal
TimeoutStartSec=120
