// graph/plans/plan-v1.1-maverick.cypher
// Source of truth for :Plan {node_id:'plan-v1.1-maverick'} and its WorkItems.
// Idempotent — every write is MERGE + SET. Re-running produces identical graph state.
// Applied by: maverick-autodeploy-{dev,prod}.service (post wi-gs-02) OR
//             maverick-dev apply graph/plans/plan-v1.1-maverick.cypher --target <env>
//
// DO NOT edit this file in-graph directly. Edit here, PR, merge, let autodeploy reconcile.
// Direct writes will be reverted on next manifest reapply (wi-gs-07).

// ============================================================================
// :Plan root
// ============================================================================
MERGE (p:Plan {node_id: 'plan-v1.1-maverick'})
SET p.name = 'plan-v1.1-maverick',
    p.title = 'v1.1 — maverick rebrand, target naming, query tracing, contributor guide SoT, seamless local fork, graph sync + repo-as-SoT',
    p.status = 'proposed',
    p.created_at = datetime('2026-04-20T16:20:00Z'),
    p.updated_at = datetime('2026-04-20T17:00:00Z'),
    p.owner = 'kshitiz',
    p.supersedes = 'plan-onboarding-binary-tdd',
    p.repo = 'Qubit-Capital/maverick',
    p.plan_doc = 'docs/plan-v1.1-maverick.md',
    p.estimated_hours = 53.5,
    p.tracks = ['A-rebrand','B-naming','C-querytrace','D-contributor-guide','E-local-fork','F-ux-tests','G-graph-sync-sot'],
    p.project = 'maverick';

// ============================================================================
// :Track nodes
// ============================================================================
UNWIND [
  {id:'track-A', letter:'A', title:'Rebrand mycelium→maverick (Path A hard fork)', hours:7},
  {id:'track-B', letter:'B', title:'Target naming (maverick-dev / maverick-local)', hours:2.5},
  {id:'track-C', letter:'C', title:'Graph-native QueryTrace', hours:7},
  {id:'track-D', letter:'D', title:'ContributorGuide as graph SoT + md projection', hours:7},
  {id:'track-E', letter:'E', title:'Local fork UX (Docker Compose, Win+Mac seamless)', hours:8},
  {id:'track-F', letter:'F', title:'UX test harness (TDD, 3 personas, CI-gated)', hours:10},
  {id:'track-G', letter:'G', title:'Graph sync + repo-as-SoT', hours:10}
] AS t
MERGE (tr:Track {node_id: t.id})
SET tr.letter = t.letter, tr.title = t.title, tr.estimated_hours = t.hours, tr.project='maverick', tr.plan='plan-v1.1-maverick'
WITH tr
MATCH (p:Plan {node_id:'plan-v1.1-maverick'})
MERGE (p)-[:HAS_TRACK]->(tr);

