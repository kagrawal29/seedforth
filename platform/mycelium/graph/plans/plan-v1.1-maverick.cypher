] AS w
MERGE (wi:WorkItem {node_id: w.id})
SET wi.title = w.title,
    wi.type = w.type,
    wi.acceptance = w.acceptance,
    wi.project = 'maverick',
    wi.plan = 'plan-v1.1-maverick',
    wi.status = coalesce(wi.status, 'pending')   // preserve status if WI already existed
WITH wi, w
MATCH (p:Plan {node_id:'plan-v1.1-maverick'})
MERGE (p)-[:HAS_WORKITEM]->(wi)
WITH wi, w
MATCH (tr:Track {node_id: w.track})
MERGE (tr)-[:HAS_WORKITEM]->(wi)
WITH wi, w
UNWIND (CASE WHEN w.deps = [] THEN [NULL] ELSE w.deps END) AS dep_id
  OPTIONAL MATCH (dep:WorkItem {node_id: dep_id})
  FOREACH (_ IN CASE WHEN dep IS NULL THEN [] ELSE [1] END |
    MERGE (wi)-[:DEPENDS_ON]->(dep)
  );

// ============================================================================
// :UXJourney nodes (three personas)
// ============================================================================
UNWIND [
  {id:'uxj-reader', persona:'reader', title:'Reader — query shared knowledge, never write', time_budget_min:5, depends_on:'Docker=no, Python=no, JDK=no, Neo4j=no', os_support:['win11','macos-arm64','macos-amd64','ubuntu']},
  {id:'uxj-contributor', persona:'contributor', title:'Contributor — write Cypher, land in maverick-dev', time_budget_min:10, depends_on:'Docker Desktop only (beyond Reader prereqs)', os_support:['win11-no-wsl','macos-arm64','macos-amd64','ubuntu']},
  {id:'uxj-maintainer', persona:'maintainer', title:'Maintainer — ops + releases', time_budget_min:0, depends_on:'SSH to pulse-server + all contributor deps', os_support:['ubuntu-pulse']}
] AS j
MERGE (uxj:UXJourney {node_id: j.id})
SET uxj.persona = j.persona,
    uxj.title = j.title,
    uxj.time_budget_min = j.time_budget_min,
    uxj.external_deps = j.depends_on,
    uxj.os_support = j.os_support,
    uxj.project = 'maverick',
    uxj.plan = 'plan-v1.1-maverick'
WITH uxj
MATCH (p:Plan {node_id:'plan-v1.1-maverick'})
MERGE (p)-[:HAS_JOURNEY]->(uxj);

// ============================================================================
// Session reflection (recorded for future session to pick up)
// ============================================================================
MERGE (r:SessionReflection {node_id: 'reflection-2026-04-20-v1.1-with-track-G'})
SET r.date = '2026-04-20',
    r.title = 'v1.1 plan committed with Track G (graph sync + repo-as-SoT)',
    r.narrative = 'Plan doc at docs/plan-v1.1-maverick.md. This file (graph/plans/plan-v1.1-maverick.cypher) is the source of truth for the Plan + 47 WorkItems. Track G is new: repo/graph as SoT, local-sync preserving work, PR-based graph changes, version switching, drift healing, admin-footgun closed. Direct admin writes to dev/prod are banned (wi-gs-08) — all future writes go through this file via autodeploy reapply (wi-gs-02). Next session: query MATCH (wi:WorkItem {plan:"plan-v1.1-maverick", status:"pending"}) WHERE NOT (wi)-[:DEPENDS_ON]->(:WorkItem {status:"pending"}) RETURN wi.node_id, wi.title. Fan out parallel Haiku agents per the feedback memory.',
    r.project = 'maverick',
    r.next_wi_suggestions = ['wi-ux-01','wi-rb-01','wi-qt-01','wi-cg-01','wi-gs-01'];

